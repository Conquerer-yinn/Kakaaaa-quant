FEISHU_BOT_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/your_webhook_id_here

# 钉钉 Webhook (可选)
DINGDING_WEBHOOK=

# 问财 Cookie (可选)
WENCAI_COOKIE=
