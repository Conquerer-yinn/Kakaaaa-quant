# Tushare API Token (获取: https://tushare.pro)
TUSHARE_TOKEN=your_tushare_token_here

# Tushare HTTP Proxy URL (可选)
TUSHARE_HTTP_URL=http://lianghua.nanyangqiankun.top

# Tushare Request Delay (seconds, 默认 0.5)
TUSHARE_REQUEST_DELAY=0.5

# 飞书机器人 Webhook (获取: https://open.feishu.cn)
FEISHU_BOT_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/your_webhook_id_here

# 钉钉 Webhook (可选)
DINGDING_WEBHOOK=

# 问财 Cookie (可选)
WENCAI_COOKIE=

# 文件配置
DAILY_BASICS_FILE=每日基础数据.xlsx
DAILY_BASICS_SHEET=Sheet1
MARKET_SENTIMENT_FILE=近期市场情绪工作簿.xlsx
MARKET_SENTIMENT_OVERVIEW_SHEET=总览
MARKET_SENTIMENT_MARKET_SHEET=总市场数据
MARKET_SENTIMENT_HEIGHT_SHEET=高度观察
MARKET_SENTIMENT_CHINEXT_SHEET=创业板专区
MARKET_SENTIMENT_RECENT_FILE=近期市场情绪工作簿.xlsx
